#!/bin/bash
# mgos-power — автоматичний «режим батареї» для сесії mgOS (НЕ для kiosk).
#
# Від мережі  → усе як є: обертова рамка, живі відео-шпалери, профіль, який ти обрав.
# Від батареї → те саме на вигляд, але без постійної перемальовки екрана:
#   • градієнтна рамка вікон лишається, лише не крутиться безперервно (borderangle без loop);
#   • відео-шпалери на паузі — на екрані лишається той самий кадр;
#   • профіль «performance» → «balanced» (на батареї PPD сам тримає EPP balance_power:
#     турбо є для ривків, але без постійного нагріву). Повертається, коли підключиш зарядку.
#
# Працює лише по подіях udev (power_supply) — без полінгу, ~0 CPU. Запускається з
# ~/.config/hypr/hyprland.conf (exec-once) і завершується разом із сесією Hyprland.
#
# Налаштування: ~/.config/mgos/power.conf (0 — вимкнути пункт):
#   BATTERY_STATIC_BORDER=1   BATTERY_PAUSE_VIDEO=1   BATTERY_BALANCED=1
#
# Команди: mgos-power watch | apply | status

BATTERY_STATIC_BORDER=1
BATTERY_PAUSE_VIDEO=1
BATTERY_BALANCED=1
BORDER_AC="borderangle,1,50,linear,loop"
BORDER_BAT="borderangle,1,50,linear"
CONF="$HOME/.config/mgos/power.conf"
[ -f "$CONF" ] && . "$CONF"

RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mgos-power"
mkdir -p "$RT"
MPV_SOCK=/tmp/mpv-socket

on_ac() {
    local d
    for d in /sys/class/power_supply/*; do
        case "$(cat "$d/type" 2>/dev/null)" in
            Mains|USB|USB_C|USB_PD) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && return 0 ;;
        esac
    done
    # немає жодного джерела живлення з online → це ПК без батареї, вважаємо «від мережі»
    ls /sys/class/power_supply/*/capacity >/dev/null 2>&1 || return 0
    return 1
}

# Захист kiosk: якщо зараз працює kiosk-сесія — нічого не чіпаємо (там свій power-saver hold).
kiosk_running() { pgrep -f 'Hyprland -c .*hyprland/kiosk\.conf' >/dev/null 2>&1 || [ "${KIOSKOS:-0}" = 1 ]; }

mpv_pause() {  # $1 = true|false
    [ -S "$MPV_SOCK" ] || return 0
    printf '{"command":["set_property","pause",%s]}\n' "$1" | timeout 2 socat - "UNIX-CONNECT:$MPV_SOCK" >/dev/null 2>&1
}

apply_battery() {
    touch "$RT/battery"
    [ "$BATTERY_STATIC_BORDER" = 1 ] && hyprctl -q keyword animation "$BORDER_BAT" >/dev/null 2>&1
    [ "$BATTERY_PAUSE_VIDEO" = 1 ] && mpv_pause true
    if [ "$BATTERY_BALANCED" = 1 ] && ! kiosk_running; then
        if [ "$(powerprofilesctl get 2>/dev/null)" = performance ]; then
            powerprofilesctl set balanced 2>/dev/null && echo performance > "$RT/restore_profile"
        fi
    fi
}

apply_ac() {
    rm -f "$RT/battery"
    hyprctl -q keyword animation "$BORDER_AC" >/dev/null 2>&1
    mpv_pause false
    if [ -f "$RT/restore_profile" ] && ! kiosk_running; then
        # повертаємо лише якщо ти сам за цей час нічого не перемикав
        [ "$(powerprofilesctl get 2>/dev/null)" = balanced ] && powerprofilesctl set "$(cat "$RT/restore_profile")" 2>/dev/null
        rm -f "$RT/restore_profile"
    fi
}

apply() {
    if on_ac; then apply_ac; echo ac > "$RT/state"; else apply_battery; echo battery > "$RT/state"; fi
}

case "${1:-watch}" in
    apply)  apply ;;
    status) echo "живлення: $(on_ac && echo мережа || echo батарея) · режим: $(cat "$RT/state" 2>/dev/null || echo —) · профіль: $(powerprofilesctl get 2>/dev/null)" ;;
    watch)
        kiosk_running && [ -z "$MGOS_POWER_FORCE" ] && { echo "kiosk-сесія — mgos-power не потрібен"; exit 0; }
        # один екземпляр на сесію
        exec 9>"$RT/lock"; flock -n 9 || exit 0
        HPID=$(pgrep -nx Hyprland)
        last=""
        apply; last=$(cat "$RT/state")
        # Чекаємо подій udev; раз на 10 хв — лише перевірка, чи живий Hyprland (і страховка стану).
        # той самий монітор udev ловить і USB/Bluetooth-пристрої — для системних звуків (окремого демона не треба)
        exec 3< <(exec udevadm monitor --udev --subsystem-match=power_supply --subsystem-match=usb/usb_device \
                       --subsystem-match=bluetooth 2>/dev/null)
        UPID=$!
        warned=""   # низький заряд: попереджаємо один раз на кожен поріг, скидається на зарядці
        while :; do
            read -r -t 600 -u 3 line; rc=$?
            [ -n "$HPID" ] && ! kill -0 "$HPID" 2>/dev/null && break
            [ $rc -gt 128 ] || [ $rc -eq 0 ] || break   # udevadm помер
            # подія приходить пачкою — даємо їй завершитись (і запам'ятовуємо, що в ній було)
            dev=""
            dev_of() {   # «UDEV [t] add /devices/... (usb)» → add/remove для пристроїв; BT — лише з'єднання hciN:NNN
                case "$1" in
                    *" add "*"(usb)"|*" add "*hci[0-9]:[0-9]*"(bluetooth)") echo added ;;
                    *" remove "*"(usb)"|*" remove "*hci[0-9]:[0-9]*"(bluetooth)") echo removed ;;
                esac
            }
            if [ $rc -eq 0 ]; then
                dev=$(dev_of "$line")
                sleep 1; while read -r -t 0.3 -u 3 line; do [ -z "$dev" ] && dev=$(dev_of "$line"); done
            fi
            [ -n "$dev" ] && "$HOME/.local/bin/mgos-sound" "device-$dev" &
            now=$(on_ac && echo ac || echo battery)
            if [ "$now" = battery ]; then
                cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
                if [ -n "$cap" ] && [ "$cap" -le 5 ] && [ "$warned" != 5 ]; then warned=5; "$HOME/.local/bin/mgos-sound" battery-caution &
                elif [ -n "$cap" ] && [ "$cap" -le 15 ] && [ -z "$warned" ]; then warned=15; "$HOME/.local/bin/mgos-sound" battery-low &
                fi
            else
                warned=""
            fi
            if [ "$now" != "$last" ]; then apply; last=$now
                "$HOME/.local/bin/mgos-sound" "$([ "$now" = ac ] && echo power-plug || echo power-unplug)" &
            elif [ "$now" = battery ] && [ "$BATTERY_PAUSE_VIDEO" = 1 ]; then mpv_pause true  # нові шпалери на батареї
            fi
        done
        # Сесія закінчилась. Профіль PPD тут свідомо НЕ чіпаємо: `powerprofilesctl set` знімає
        # утримання power-saver, яке ставить kiosk-сесія, якщо вона саме стартує.
        kill "$UPID" 2>/dev/null
        rm -f "$RT/battery" "$RT/restore_profile" "$RT/state"
        ;;
    *) echo "використання: mgos-power [watch|apply|status]"; exit 1 ;;
esac
