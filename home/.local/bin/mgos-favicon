#!/usr/bin/env python3
# mgos-favicon <домен> <вихідний файл> — найкраща іконка сайту для плашки сповіщень.
# Порядок: <link rel="apple-touch-icon"/"icon" sizes=...> зі сторінки (найбільша) → /apple-touch-icon.png → /favicon.ico.
# Звертається лише до самого сайту (без сторонніх сервісів), з таймаутами й обмеженням розміру.
import sys, re, urllib.request, urllib.parse, ssl
dom, out = sys.argv[1], sys.argv[2]
if not re.fullmatch(r"[a-z0-9-]+(\.[a-z0-9-]+)+", dom): sys.exit(1)
UA = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) mgOS-notify"}
ctx = ssl.create_default_context()
def get(url, limit):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=2, context=ctx) as r:
        data = r.read(limit + 1)
        if len(data) > limit: raise ValueError("too big")
        return r.geturl(), r.headers.get_content_type(), data
cands = []
for base in (f"https://{dom}/", f"https://www.{dom}/"):
    try:
        url, ct, html = get(base, 1_500_000)
    except Exception:
        continue
    if "html" not in ct: continue
    for tag in re.findall(rb"<link\b[^>]*>", html[:600_000], re.I):
        t = tag.decode("utf-8", "replace")
        rel = re.search(r'rel\s*=\s*["\']?([^"\'>]+)', t, re.I)
        href = re.search(r'href\s*=\s*["\']?([^"\'\s>]+)', t, re.I)
        if not rel or not href or "icon" not in rel.group(1).lower(): continue
        if "mask-icon" in rel.group(1).lower(): continue          # одноколірний svg Safari
        sz = re.search(r'sizes\s*=\s*["\']?(\d+)', t, re.I)
        size = int(sz.group(1)) if sz else (180 if "apple" in rel.group(1).lower() else 32)
        h = href.group(1)
        if h.lower().endswith(".svg"): continue
        cands.append((size, urllib.parse.urljoin(url, h)))
    break
cands.sort(key=lambda c: -c[0])
cands += [(0, f"https://{dom}/apple-touch-icon.png"), (0, f"https://{dom}/favicon.ico")]
for _, u in cands[:6]:
    if not u.startswith("https://"): continue
    try:
        _, ct, data = get(u, 700_000)
    except Exception:
        continue
    if ct.startswith("image/") or data[:4] in (b"\x89PNG", b"\x00\x00\x01\x00") or data[:3] == b"\xff\xd8\xff":
        open(out, "wb").write(data); sys.exit(0)
sys.exit(1)
