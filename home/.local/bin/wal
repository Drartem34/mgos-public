#!/bin/bash
# Цей скрипт-обгортка вирішує проблему кешування Pywal для відео шпалер.
# Оскільки шпалерний рушій тепер завжди зберігає кадр як sddm_frame.png,
# Pywal думав, що це та сама картинка, і не генерував нові кольори.

# Видаляємо кеш саме для цього кадру перед кожним запуском:
rm -f ~/.cache/wal/schemes/*sddm_frame_png*

# Запускаємо справжній Pywal з усіма переданими аргументами:
exec /usr/bin/wal "$@"
