#!/usr/bin/env python3
# mgos-accent — акцент mgOS зі шпалер (той самий алгоритм, що sysui::smart_wal_accent у SYSui/sysui_common.h).
# pywal --color5 часто «чужий» колір (сірий/іншої гами), тож беремо колір із домінантної групи відтінків
# color1..6: найнасиченіший, середньої яскравості; яскравість затискаємо в 0.45..0.66.
# Виклик: mgos-accent            → #rrggbb (з ~/.cache/wal/colors.css)
#         mgos-accent --custom   → враховує accent_mode=custom із settings.json
import colorsys, json, os, re, sys

def wal_colors(path=os.path.expanduser("~/.cache/wal/colors.css")):
    try: css = open(path).read()
    except OSError: return {}
    return {int(k): v for k, v in re.findall(r"--color(\d+):\s*(#[0-9A-Fa-f]{6})", css)}

def smart_accent(cols):
    cs = []
    for i in range(1, 7):
        hx = cols.get(i)
        if not hx: continue
        r, g, b = (int(hx[j:j + 2], 16) / 255 for j in (1, 3, 5))
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        if s < 0.15 or l < 0.15 or l > 0.9: continue
        cs.append((hx, h * 360, s, l))
    if not cs: return cols.get(5, "#9929CF")
    dist = lambda a, b: min(abs(a - b), 360 - abs(a - b))
    def score(c):
        support = sum(o[2] for o in cs if o is not c and dist(c[1], o[1]) <= 35)
        return support + c[2] - abs(c[3] - 0.55) * 1.2
    hx, h, s, l = max(cs, key=score)   # max → перший із рівних, як у C++
    l2, s2 = min(max(l, 0.45), 0.66), max(s, 0.45)
    if (l2, s2) == (l, s): return hx
    r, g, b = colorsys.hls_to_rgb(h / 360, l2, s2)
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))

def accent(custom=True):
    if custom:
        try:
            d = json.load(open(os.path.expanduser("~/.config/megumin-os/settings.json")))
            if d.get("accent_mode") == "custom" and re.fullmatch(r"#[0-9A-Fa-f]{6}", str(d.get("accent_color", ""))):
                return d["accent_color"]
        except Exception: pass
    return smart_accent(wal_colors())

if __name__ == "__main__":
    print(accent("--custom" in sys.argv))
