#!/bin/bash
# mgos-sound <подія> [--force]  — системний звук mgOS (тема freedesktop, напр. message-new-instant, power-plug).
# Вимикається в «Налаштування → Системні звуки» (sounds_enabled), окремі події — sounds_off:[...].
# --force грає навіть при вимкнених звуках (прев'ю в Налаштуваннях).
ev="$1"; [ -n "$ev" ] || { echo "використання: mgos-sound <подія> [--force]"; exit 1; }
# Гучність: клавішу затиснули → десятки подій на секунду. Граємо ОДИН раз, коли натискання припинились
# (затримка 150 мс; кожне нове натискання відкладає звук), і ніколи поверх попереднього.
if [ "$ev" = audio-volume-change ] && [ "$2" != --force ]; then
    st="${XDG_RUNTIME_DIR:-/tmp}/mgos-sound-volume"
    me="$$.$RANDOM"; echo "$me" > "$st"
    sleep 0.15
    [ "$(cat "$st" 2>/dev/null)" = "$me" ] || exit 0          # було новіше натискання — звучить воно
    exec 8>"$st.lock"; flock -n 8 || exit 0                    # попередній «ток» ще грає — не перебиваємо
fi
CFG="$HOME/.config/megumin-os/settings.json"
read -r on theme vol off < <(python3 -I - "$CFG" "$ev" <<'PY' 2>/dev/null
import json, sys
try: s = json.load(open(sys.argv[1]))
except Exception: s = {}
ev = sys.argv[2]
print("1" if s.get("sounds_enabled", True) else "0", s.get("sound_theme", "mgos") or "mgos",
      int(s.get("sounds_volume", 70)), "1" if ev in s.get("sounds_off", []) else "0")
PY
)
[ "$2" = --force ] || { [ "${on:-1}" = 1 ] && [ "${off:-0}" = 0 ] || exit 0; }
pgrep -f 'Hyprland -c .*hyprland/kiosk\.conf' >/dev/null 2>&1 && [ "$2" != --force ] && exit 0   # kiosk — тиша
find_snd() {  # $1 тема → шлях (з урахуванням Inherits)
    local t="$1" d f inh
    for d in "$HOME/.local/share/sounds/$t" "/usr/share/sounds/$t"; do
        for f in "$d"/stereo/"$ev".{oga,ogg,wav} "$d"/stereo/"${ev%%-*}".{oga,ogg,wav}; do [ -f "$f" ] && { echo "$f"; return; }; done
        if [ -f "$d/index.theme" ]; then
            inh=$(sed -n 's/^Inherits=//p' "$d/index.theme" | head -1 | cut -d, -f1)
            [ -n "$inh" ] && [ "$inh" != "$t" ] && { find_snd "$inh"; return; }
        fi
    done
}
f=$(find_snd "${theme:-mgos}"); [ -n "$f" ] || f=$(find_snd freedesktop)
[ -n "$f" ] || exit 0
v=$(awk -v v="${vol:-70}" 'BEGIN{printf "%.2f", v/100}')
exec pw-play --volume "$v" "$f" >/dev/null 2>&1
