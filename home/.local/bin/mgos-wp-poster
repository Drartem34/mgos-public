#!/bin/bash
# ============================================================================
#  mgOS: «постер» поточних шпалер — нерухома картинка, яку видно МИТТЄВО.
#  Відео-шпалерам (mpvpaper) треба ~1 с, щоб показати перший кадр; щоб у цей час
#  не світився порожній фон, при вході спершу показуємо постер (swaybg), а потім
#  поверх нього — живі шпалери. Той самий постер бере тема SDDM.
#
#    mgos-wp-poster            — надрукувати шлях до постера (створити, якщо застарів)
#    mgos-wp-poster --source   — надрукувати шлях до самих шпалер (з урахуванням динамічних)
#    mgos-wp-poster --cached   — лише готовий постер, без генерації (для швидкого входу)
# ============================================================================
LAST="$HOME/.cache/ignis/last_wallpaper.txt"
OUT_DIR="$HOME/.cache/megumin-os"
POSTER="$OUT_DIR/wp_poster.jpg"
SRC_MARK="$OUT_DIR/wp_poster.src"

p=$(head -1 "$LAST" 2>/dev/null)
# піксельні живі шпалери (pixel:<стиль>) — постер малює сам pixel_wallpaper
if [[ $p == pixel:* ]]; then
    [ "${1:-}" = "--source" ] && { printf '%s\n' "$p"; exit 0; }
    PX="$OUT_DIR/wp_poster_pixel.png"
    if [ -f "$PX" ] && [ "$(cat "$SRC_MARK" 2>/dev/null)" = "$p" ] && [ "$PX" -nt "$HOME/.cache/wal/colors.css" ] \
       && [ "$PX" -nt "$HOME/.config/megumin-os/settings.json" ]; then printf '%s\n' "$PX"; exit 0; fi
    [ "${1:-}" = "--cached" ] && [ -f "$PX" ] && { printf '%s\n' "$PX"; exit 0; }
    mkdir -p "$OUT_DIR"
    W=1920; H=1080
    if command -v hyprctl >/dev/null && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        read -r W H < <(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width*.height) | "\(.width) \(.height)"' 2>/dev/null) || true
        [ -n "$W" ] && [ -n "$H" ] || { W=1920; H=1080; }
    fi
    "$HOME/.config/SYSui/pixel_wallpaper" --poster "$PX" "${W}x${H}" && printf '%s' "$p" > "$SRC_MARK" && printf '%s\n' "$PX"
    exit 0
fi
# Динамічні шпалери (тека з morning/day/evening/night.*): файл під поточну годину
if [ -n "$p" ] && [ -d "$p" ]; then
    h=$((10#$(date +%H)))
    if   [ $h -ge 6 ]  && [ $h -lt 12 ]; then per=morning
    elif [ $h -ge 12 ] && [ $h -lt 18 ]; then per=day
    elif [ $h -ge 18 ] && [ $h -lt 22 ]; then per=evening
    else per=night; fi
    d=$p; p=""
    for e in jpg png jpeg webp mp4 webm gif; do
        [ -f "$d/$per.$e" ] && { p="$d/$per.$e"; break; }
    done
fi
[ "${1:-}" = "--source" ] && { printf '%s\n' "$p"; exit 0; }
[ -n "$p" ] && [ -f "$p" ] || exit 1

ext=${p##*.}; ext=${ext,,}
case "$ext" in
    mp4|webm|gif|mkv|mov) ;;
    *) printf '%s\n' "$p"; exit 0 ;;   # картинка — сама собі постер
esac

# відео: перший кадр у розмірі екрана (JPEG — декодується за мілісекунди)
if [ -f "$POSTER" ] && [ "$(cat "$SRC_MARK" 2>/dev/null)" = "$p" ] && [ "$POSTER" -nt "$p" ]; then
    printf '%s\n' "$POSTER"; exit 0
fi
[ "${1:-}" = "--cached" ] && exit 1
mkdir -p "$OUT_DIR"
W=1920; H=1080
if command -v hyprctl >/dev/null && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    read -r W H < <(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width*.height) | "\(.width) \(.height)"' 2>/dev/null) || true
    [ -n "$W" ] && [ -n "$H" ] || { W=1920; H=1080; }
fi
tmp="$POSTER.tmp.jpg"
if ffmpeg -loglevel error -y -i "$p" -frames:v 1 \
        -vf "scale=${W}:${H}:force_original_aspect_ratio=increase,crop=${W}:${H}" -q:v 3 "$tmp" 2>/dev/null \
   && [ -s "$tmp" ]; then
    mv -f "$tmp" "$POSTER"; printf '%s\n' "$p" > "$SRC_MARK"
    printf '%s\n' "$POSTER"; exit 0
fi
rm -f "$tmp"
exit 1
