#!/usr/bin/env bash
# mgos-bakeblur — «запечений блюр»: розмите зображення шпалер для кожного монітора.
# Результат: ~/.cache/mgos/baked_blur_<монітор>.png (розмір = логічний розмір монітора).
# Перегенерація лише при зміні шпалер/теми/акценту/параметрів блюру (stamp); --force — завжди.
# Постійних процесів не має: запускається разовим викликом (topbar при зміні theme_stamp, wallpapers).
set -u
CACHE="$HOME/.cache/mgos"
STAMP_F="$CACHE/baked_blur.stamp"
SET="$HOME/.config/megumin-os/settings.json"
mkdir -p "$CACHE"
[ "${BB_DEBUG:-0}" = 1 ] && { exec 2>"$CACHE/baked_blur.log"; set -x; }
LOCK="$CACHE/baked_blur.lock"
exec 9>"$LOCK"; flock -n 9 || exit 0

[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || exit 0

# ---- живий блюр Hyprland для запечених віджетів: ~/.config/hypr/blur-layers.conf ----
# baked_blur увімкнене і файли блюру є → правил нема (віджети малюють блюр самі); інакше — живий layerrule blur.
write_layers() {
  local want=1 f="$HOME/.config/hypr/blur-layers.conf" body
  grep -Eq '"baked_blur"\s*:\s*false' "$SET" 2>/dev/null && want=0
  [ "${1:-}" = live ] && want=0   # поки йде запікання — тимчасово справжній (живий) блюр
  if [ $want = 1 ]; then
    while read -r n w h; do [ -n "$n" ] && { [ -f "$CACHE/baked_blur_$n.png" ] || want=0; }; done <<<"$MONS"
  fi
  if [ $want = 1 ]; then
    body="# mgOS: запечений блюр лише для topbar/годинника; віджети поверх програм (dock, osd, runner, буфер, меню живлення, cc) лишаються на живому блюрі Hyprland — інакше xray. Файл перезаписується.
layerrule = blur on, ignore_alpha 0.5, match:namespace dock
layerrule = blur on, ignore_alpha 0.1, match:namespace megumin_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace volume_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace brightness_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace notify_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace powermenu
layerrule = blur on, ignore_alpha 0.1, match:namespace clipboard
layerrule = blur on, ignore_alpha 0, match:namespace runner
layerrule = blur on, ignore_alpha 0.1, match:namespace control_center"
  else
    body="# mgOS: живий блюр Hyprland для віджетів SYSui (запечений блюр вимкнено або ще не згенеровано). Файл перезаписується.
layerrule = blur on, ignore_alpha 0.5, match:namespace dock
layerrule = blur on, ignore_alpha 0.1, match:namespace megumin_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace volume_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace brightness_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace notify_osd
layerrule = blur on, ignore_alpha 0.1, match:namespace powermenu
layerrule = blur on, ignore_alpha 0.1, match:namespace clipboard
layerrule = blur on, ignore_alpha 0.1, match:namespace topbar
layerrule = blur on, ignore_alpha 0.1, match:namespace mgos-dashboard
layerrule = blur on, ignore_alpha 0, match:namespace runner
layerrule = blur on, ignore_alpha 0.1, match:namespace control_center"
  fi
  [ "$(cat "$f" 2>/dev/null)" = "$body" ] || { printf '%s\n' "$body" > "$f.tmp" && mv -f "$f.tmp" "$f"; }
}
LAST=$(head -1 "$HOME/.cache/ignis/last_wallpaper.txt" 2>/dev/null)
[ -n "$LAST" ] || exit 0

# ---- параметри блюру з hyprland ----
BU="$HOME/.config/hypr/blur-user.conf"
getp() { grep -E "^\s*$1\s*=" "$BU" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d ' '; }
SIZE=$(getp size); PASSES=$(getp passes); CONTRAST=$(getp contrast); VIB=$(getp vibrancy)
BRI=$(getp brightness)
SIZE=${SIZE:-5}; PASSES=${PASSES:-4}; CONTRAST=${CONTRAST:-0.89}; VIB=${VIB:-0.17}; BRI=${BRI:-1.0}

# ---- монітори: ім'я WxH(логічний) ----
MONS=$(hyprctl monitors 2>/dev/null | awk '
  /^Monitor /{name=$2}
  /^\t[0-9]+x[0-9]+@/{split($1,a,"@"); res=a[1]}
  /^\tscale:/{sc=$2; split(res,r,"x"); printf "%s %d %d\n", name, r[1]/sc+0.5, r[2]/sc+0.5}')
[ -n "$MONS" ] || exit 0

# ---- джерело ----
WPSRC=""; WPM=0
case "$LAST" in
  pixel:*) WPSRC="$LAST"; PX="$HOME/.config/SYSui/pixel_wallpaper"; WPM=$(stat -c %Y "$PX" 2>/dev/null);;
  *) WPSRC="$LAST"; WPM=$(stat -c %Y "$LAST" 2>/dev/null || echo 0);;
esac
STAMP="$WPSRC|$WPM|$(stat -c %Y "$SET" 2>/dev/null)|$(stat -c %Y "$HOME/.cache/wal/colors.css" 2>/dev/null)|$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)|$SIZE $PASSES $CONTRAST $VIB $BRI|$MONS"
STAMP=$(printf '%s' "$STAMP" | md5sum | cut -d' ' -f1)
if [ "${1:-}" != "--force" ] && [ "$(cat "$STAMP_F" 2>/dev/null)" = "$STAMP" ]; then
  ok=1; while read -r n w h; do [ -f "$CACHE/baked_blur_$n.png" ] || ok=0; done <<<"$MONS"
  [ $ok = 1 ] && { write_layers; exit 0; }
fi

write_layers live   # старе запікання застаріле: до готовності нового показуємо живий блюр Hyprland
TMP=$(mktemp -d /tmp/bakeblur.XXXXXX); trap 'rm -rf "$TMP"' EXIT
# sigma ≈ як у kawase: size*2^passes/2.5 (повна роздільність); рахуємо на 1/8 → sigma/8 (швидше, блюр і так м'який)
SIGMA=$(awk -v s="$SIZE" -v p="$PASSES" 'BEGIN{printf "%.1f", s*(2^p)/2.5/8}')
MOD=$(awk -v v="$VIB" 'BEGIN{printf "%d", 100+v*100}')
BC=$(awk -v c="$CONTRAST" -v b="$BRI" 'BEGIN{printf "%d,%d", (b-1)*100, (c-1)*100}')

while read -r n w h; do
  [ -n "$n" ] || continue
  SRC="$TMP/src_$n.png"
  case "$WPSRC" in
    pixel:*) "$HOME/.config/SYSui/pixel_wallpaper" --poster "$SRC" "${w}x${h}" >/dev/null 2>&1 || continue;;
    *.mp4|*.mkv|*.webm|*.gif|*.mov) ffmpeg -v error -y -i "$WPSRC" -frames:v 1 "$SRC" </dev/null || continue;;
    *) [ -f "$WPSRC" ] || continue; cp "$WPSRC" "$SRC" 2>/dev/null || continue;;
  esac
  OUT="$CACHE/baked_blur_$n.png"
  # cover до розміру монітора → ¼ → gauss → назад; насиченість/контраст як у Hyprland blur
  magick "${SRC}[0]" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" \
      -filter box -resize 12.5% -gaussian-blur "0x${SIGMA}" -modulate "100,${MOD},100" -brightness-contrast "$BC" \
      -filter triangle -resize "${w}x${h}!" -strip -define png:compression-level=1 "PNG24:$TMP/out_$n.png" 2>/dev/null || continue
  mv -f "$TMP/out_$n.png" "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
done <<<"$MONS"
printf '%s' "$STAMP" > "$STAMP_F.tmp" && mv -f "$STAMP_F.tmp" "$STAMP_F"
write_layers
