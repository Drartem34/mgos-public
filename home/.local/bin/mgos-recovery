#!/usr/bin/env bash
# ============================================================================
#  mgos-recovery — відновлення mgOS із GitHub («Налаштування» → Система → Відновити систему)
#
#  Тримає ОКРЕМУ чисту копію інсталятора в ~/.local/share/mgos/recovery (не залежить від
#  локальних, можливо зламаних файлів), оновлює її з git і запускає графічний інсталятор:
#  там можна вибрати «Відновлення» (повернути конфіги, панелі, тему) або повне встановлення.
#
#  Репозиторій: повна версія Drartem34/mgos, якщо є доступ через «gh auth login»,
#  інакше публічна Drartem34/mgos-public. Перевизначити: MGOS_REPO=user/repo mgos-recovery
# ============================================================================
set -uo pipefail
DIR=${MGOS_RECOVERY_DIR:-$HOME/.local/share/mgos/recovery}
say() { printf '\n\033[1;35m▸ %s\033[0m\n' "$*"; }
die() { printf '\n\033[1;31m✗ %s\033[0m\n' "$*"; read -rp "Enter — закрити" _; exit 1; }

printf '\033[1;35m━━ Відновлення mgOS ━━\033[0m\n'
echo "Буде завантажено свіжий інсталятор із GitHub і відкрито його вікно."
echo "Нічого не змінюється, доки ви самі не натиснете «Почати» в інсталяторі."
read -rp "Продовжити? [Y/n] " a
case "${a:-y}" in [nNнН]*) exit 0 ;; esac

command -v git >/dev/null || { say "Ставлю git"; sudo pacman -S --needed --noconfirm git || die "Не вдалося встановити git"; }

if [ -z "${MGOS_REPO:-}" ]; then
    MGOS_REPO=Drartem34/mgos-public
    if command -v gh >/dev/null && gh auth status &>/dev/null && gh repo view Drartem34/mgos &>/dev/null; then
        MGOS_REPO=Drartem34/mgos
    fi
fi
URL="https://github.com/$MGOS_REPO.git"
[ "$MGOS_REPO" = Drartem34/mgos ] && command -v gh >/dev/null && gh auth setup-git &>/dev/null

if [ -d "$DIR/.git" ] && [ "$(git -C "$DIR" remote get-url origin 2>/dev/null)" = "$URL" ]; then
    say "Оновлюю копію інсталятора ($MGOS_REPO)"
    git -C "$DIR" fetch --depth 1 origin || die "Немає зв'язку з GitHub (перевір інтернет)"
    # копія «чиста» за задумом — скидаємо будь-які локальні зміни
    git -C "$DIR" reset --hard FETCH_HEAD -q && git -C "$DIR" clean -fdq
else
    say "Завантажую інсталятор ($MGOS_REPO)"
    rm -rf "$DIR.new"
    git clone --depth 1 "$URL" "$DIR.new" || die "Не вдалося завантажити $URL"
    rm -rf "$DIR" && mv "$DIR.new" "$DIR"
fi
say "Версія: $(git -C "$DIR" log -1 --format='%h · %cd · %s' --date=short)"
[ -x "$DIR/install-gui.sh" ] || chmod +x "$DIR/install-gui.sh" 2>/dev/null
say "Відкриваю інсталятор"
exec "$DIR/install-gui.sh"
