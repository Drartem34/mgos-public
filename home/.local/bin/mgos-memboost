#!/bin/bash
# ============================================================================
#  mgos-memboost — агресивніший zram, поки йде гра або бракує пам'яті.
#  Системна служба (root): sysctl vm.* змінювати може лише root.
#  Ставиться: sudo mgos-zram boost-install  (копія в /usr/local/bin + mgos-memboost.service)
#
#  Звичайний режим (як у /etc/sysctl.d/99-mgos-zram.conf):
#     swappiness 150 · watermark_scale_factor 125 · compaction_proactiveness 20 · vfs_cache_pressure 100
#  Ігровий режим:
#     swappiness 200            — охочіше витісняти холодне в zram, лишати RAM грі
#     watermark_scale_factor 400 — kswapd заздалегідь тримає ~4% RAM вільною: менше «фризів» на виділенні
#     compaction_proactiveness 0 — без фонового ущільнення пам'яті посеред гри (мікрофризи)
#     vfs_cache_pressure 50      — довше тримати кеш файлової системи (ресурси гри)
#   + один раз стискає фонові програми користувача (Firefox, Telegram, Discord…) у zram (mgos-pageout).
#
#  Тригери: гра (Steam reaper SteamLaunch, wineserver/Proton, gamescope, Minecraft, *.exe)
#           або тиск на пам'ять (PSI some avg10 > 5%) чи MemAvailable < 15%.
#  Вихід з ігрового — через 30 с без тригерів. Вимкнути: «Налаштування → Продуктивність → Пам'ять»
#  (mem_boost=false у ~/.config/megumin-os/settings.json).
#  Стан для «Налаштувань»: /run/mgos-memboost (рядок «mode причина»).
# ============================================================================
set -u
STATE=/run/mgos-memboost
STEP=4
HOLD=30
PAGEOUT=/usr/local/bin/mgos-pageout
BG_APPS='firefox|telegram-desktop|Telegram|discord|Discord|vesktop|spotify|code|code-oss|chromium|chrome|obsidian|thunderbird'

set_mode() {   # $1 normal|game
    if [ "$1" = game ]; then
        sysctl -q vm.swappiness=200 vm.watermark_scale_factor=400 vm.compaction_proactiveness=0 vm.vfs_cache_pressure=50
    else
        sysctl -q vm.swappiness=150 vm.watermark_scale_factor=125 vm.compaction_proactiveness=20 vm.vfs_cache_pressure=100
    fi
}

session_user() {   # власник сесії Hyprland (для settings.json і стискання фонових програм)
    local p; p=$(pgrep -o -x Hyprland) || return 1
    stat -c %U "/proc/$p"
}

enabled() {
    local u="$1" h f
    h=$(getent passwd "$u" | cut -d: -f6); f="$h/.config/megumin-os/settings.json"
    ! grep -qE '"mem_boost"[[:space:]]*:[[:space:]]*false' "$f" 2>/dev/null
}

find_game() {   # → назва гри / причина, або нічого
    local d cmd comm
    for d in /proc/[0-9]*; do
        comm=$(cat "$d/comm" 2>/dev/null) || continue
        case "$comm" in
            gamescope) echo "gamescope"; return ;;
            wineserver) echo "Wine/Proton"; return ;;
            *.exe|*.EXE)
                case "$comm" in steam.exe|explorer.exe|services.exe|winedevice.exe|plugplay.exe|svchost.exe|rpcss.exe|tabtip.exe|conhost.exe|start.exe) ;;
                *) echo "${comm%.*}"; return ;; esac ;;
            reaper|java)
                cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)
                case "$cmd" in
                    *SteamLaunch*AppId=*) echo "Steam (AppId $(sed -n 's/.*AppId=\([0-9]*\).*/\1/p' <<<"$cmd"))"; return ;;
                    *[Mm]inecraft*) echo "Minecraft"; return ;;
                esac ;;
        esac
    done
}

mem_reason() {
    local some avail total
    some=$(awk '/^some/{split($2,a,"="); print int(a[2])}' /proc/pressure/memory 2>/dev/null)
    [ "${some:-0}" -gt 5 ] && { echo "тиск на пам'ять"; return; }
    avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo); total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
    [ $((avail * 100 / total)) -lt 15 ] && echo "мало вільної пам'яті"
}

pageout_bg() {   # стиснути фонові програми користувача (від його імені: mgos-pageout працює лише з «своїми» процесами)
    local u="$1" pids
    pids=$(pgrep -u "$u" -x "$BG_APPS" | tr '\n' ' ')
    [ -n "$pids" ] && [ -x "$PAGEOUT" ] && runuser -u "$u" -- nice -n 19 "$PAGEOUT" --tree $pids >/dev/null 2>&1 &
}

mode=normal; last_hit=0
set_mode normal; echo "normal" > "$STATE"
trap 'set_mode normal; echo normal > "$STATE"; exit 0' TERM INT
while :; do
    now=$(date +%s)
    u=$(session_user || true)
    reason=""
    if [ -n "$u" ] && enabled "$u"; then
        g=$(find_game)
        if [ -n "$g" ]; then reason="гра: $g"; else reason=$(mem_reason); fi
    fi
    if [ -n "$reason" ]; then
        last_hit=$now
        if [ "$mode" = normal ]; then
            mode=game; set_mode game
            [[ "$reason" == гра:* ]] && pageout_bg "$u"
        fi
        echo "game $reason" > "$STATE"
    elif [ "$mode" = game ] && [ $((now - last_hit)) -ge $HOLD ]; then
        mode=normal; set_mode normal; echo "normal" > "$STATE"
    fi
    sleep "$STEP"
done
