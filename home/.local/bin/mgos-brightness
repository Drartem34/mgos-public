#!/usr/bin/env python3
"""mgOS: яскравість екрана на будь-якому залізі — один інструмент для клавіш, OSD, Control Center і Налаштувань.

  mgos-brightness get            → «<відсотки> <спосіб>», напр. «70 ddc»
  mgos-brightness set <1..100>   → встановити, друкує те саме
  mgos-brightness up | down      → крок 5% (внизу 1%), друкує нове значення одразу (повільний DDC — у фоні)
  mgos-brightness detect         → перевизначити спосіб (після заміни монітора)
  mgos-brightness restore        → при вході: повернути збережену яскравість і нічне світло (exec-once)
  mgos-brightness night [on|off] → нічне світло (4000K) — той самий процес hyprsunset, що й затемнення:
                                   без цього вимкнення нічного світла (killall) скидало б яскравість

Спосіб обирається сам, у такому порядку:
  backlight — /sys/class/backlight (ноутбук): справжня підсвітка;
  ddc       — DDC/CI зовнішнього монітора через ddcutil: справжня підсвітка монітора;
  soft      — hyprsunset: гама GPU (працює на будь-якому моніторі, лише затемнює, не яскравіше за 100%).
Результат визначення кешується (~/.cache/mgos/brightness.json) з прив'язкою до монітора — перевірка DDC на
моніторі без DDC займає секунди, а клавіша має спрацьовувати миттєво.
"""
import fcntl, json, os, subprocess, sys, time
from pathlib import Path

CACHE = Path.home() / ".cache" / "mgos" / "brightness.json"
STATE = Path.home() / ".local" / "state" / "mgos" / "brightness.json"
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "mgos-brightness.lock"
SOFT_MIN = 20          # нижче гама робить екран майже чорним — легко «загубити» монітор


def sh(*a, timeout=15):
    try:
        r = subprocess.run(a, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except Exception:
        return 1, ""


def load(p, d):
    try: return json.loads(p.read_text())
    except Exception: return d


def save(p, v):
    p.parent.mkdir(parents=True, exist_ok=True)
    t = p.with_suffix(".tmp"); t.write_text(json.dumps(v)); os.replace(t, p)


def backlight():
    b = Path("/sys/class/backlight")
    for d in sorted(b.iterdir()) if b.is_dir() else []:
        if (d / "max_brightness").exists(): return d
    return None


def monitor_id():
    """Ідентифікатор набору моніторів — кеш способу недійсний, якщо монітор змінився."""
    rc, out = sh("hyprctl", "monitors", "-j", timeout=3)
    try: return "|".join(sorted(m.get("description", m.get("name", "")) for m in json.loads(out)))
    except Exception: return ""


def detect(force=False):
    mid = monitor_id()
    c = load(CACHE, {})
    if not force and c.get("monitor") == mid and c.get("backend"): return c
    c = {"monitor": mid, "backend": "soft"}
    if backlight():
        c["backend"] = "backlight"
    elif subprocess.run(["sh", "-c", "command -v ddcutil"], capture_output=True).returncode == 0:
        rc, out = sh("ddcutil", "getvcp", "10", "--brief", "--sleep-multiplier", "1.5", timeout=20)
        # «VCP 10 C 70 100» — поточне і максимум
        p = out.split()
        if rc == 0 and len(p) >= 5 and p[0] == "VCP" and p[3].isdigit() and p[4].isdigit() and int(p[4]) > 0:
            c.update(backend="ddc", max=int(p[4]))
            st = load(STATE, {}); st["ddc"] = round(100 * int(p[3]) / int(p[4])); save(STATE, st)
    save(CACHE, c)
    return c


def get(c):
    b = c["backend"]
    if b == "backlight":
        d = backlight()
        try: return round(100 * int((d / "brightness").read_text()) / max(1, int((d / "max_brightness").read_text()))), b
        except Exception: return 100, b
    return int(load(STATE, {}).get(b, 100)), b


def soft_apply(v=None):
    """Один hyprsunset на дві речі: гама (затемнення на ПК без DDC) і температура (нічне світло)."""
    st = load(STATE, {})
    if v is None: v = int(st.get("soft", 100)) if detect().get("backend") == "soft" else 100
    v = max(SOFT_MIN, min(100, v))
    night = bool(st.get("night"))
    temp = ["temperature", "4000"] if night else ["identity"]
    if subprocess.run(["pgrep", "-x", "hyprsunset"], capture_output=True).returncode != 0:
        if v >= 100 and not night: return   # ні затемнення, ні нічного світла — процес не потрібен
        if not any((Path(d) / "hyprsunset").exists() for d in os.environ.get("PATH", "/usr/bin").split(":")):
            sh("notify-send", "-a", "Яскравість", "Немає hyprsunset",
               "Монітор не підтримує DDC/CI — для затемнення потрібен пакет hyprsunset: sudo pacman -S hyprsunset", timeout=3)
            return
        subprocess.Popen(["hyprsunset", "--identity"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(30):            # чекаємо IPC-сокет hyprsunset
            if sh("hyprctl", "hyprsunset", "gamma", str(v), timeout=2)[0] == 0: break
            time.sleep(0.1)
    else:
        sh("hyprctl", "hyprsunset", "gamma", str(v), timeout=2)
    sh("hyprctl", "hyprsunset", *temp, timeout=2)


def apply(c, v):
    b = c["backend"]
    if b == "backlight":
        d = backlight(); mx = int((d / "max_brightness").read_text())
        raw = max(1, round(v * mx / 100))
        try: (d / "brightness").write_text(str(raw))
        except Exception: sh("brightnessctl", "-q", "set", f"{v}%")
        return
    st = load(STATE, {}); st[b] = v; save(STATE, st)
    if b == "ddc":
        # DDC повільний (50–500 мс) і не терпить паралельних запитів: лише останнє значення, під замком
        with open(LOCK, "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            if int(load(STATE, {}).get("ddc", v)) != v: return     # поки чекали — натиснули ще раз
            raw = round(v * c.get("max", 100) / 100)
            if sh("ddcutil", "setvcp", "10", str(raw), "--noverify", timeout=10)[0] != 0:
                detect(force=True)                                  # DDC зник (інший вхід монітора?) — перевизначити
    else:
        soft_apply(v)


def step(cur, d):
    s = 1 if (cur <= 10 and d < 0) or (cur < 10 and d > 0) else 5
    return max(1, min(100, round((cur + d * s) / s) * s))


def main(a):
    cmd = a[0] if a else "get"
    if cmd == "detect":
        c = detect(force=True); print(*get(c)); return 0
    c = detect()
    if cmd == "get":
        print(*get(c)); return 0
    if cmd == "restore":
        v, b = get(c)
        if b == "ddc" and v < 100: apply(c, v)
        soft_apply()                    # затемнення (soft) і/або нічне світло
        return 0
    if cmd == "night":
        st = load(STATE, {})
        if len(a) > 1:
            st["night"] = a[1] in ("on", "1", "true"); save(STATE, st); soft_apply()
        print("on" if st.get("night") else "off"); return 0
    cur, b = get(c)
    if cmd in ("up", "down"): v = step(cur, 1 if cmd == "up" else -1)
    elif cmd == "set" and len(a) > 1: v = max(1, min(100, int(float(a[1]))))
    else:
        print(__doc__); return 2
    if b == "soft": v = max(SOFT_MIN, v)
    print(v, b, flush=True)
    if b == "ddc" and cmd in ("up", "down", "set"):
        # значення вже надруковане (OSD показує миттєво), сам DDC-запис — у фоні
        st = load(STATE, {}); st["ddc"] = v; save(STATE, st)
        if os.fork() == 0:
            os.setsid(); sys.stdout = open(os.devnull, "w"); apply(c, v); os._exit(0)
        return 0
    apply(c, v)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
