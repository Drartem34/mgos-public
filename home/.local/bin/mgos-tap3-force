#!/usr/bin/env python3
"""mgos-tap3-force — Runner по кліку трьома пальцями з урахуванням сили натиску (Magic Trackpad).
Режим береться з ~/.config/mgos/tap3.json: {"force": 25|50}. 0 — демон не потрібен (виходить).
 25 — звичайний клік трьома пальцями відкриває Runner;
 50 — клік, а потім сильніший натиск (другий «клік») відкриває Runner.
Лише читає evdev (без grab), у kiosk не стартує, виходить, коли режим 0."""
import json, os, socket, sys, time, select

CFG = os.path.expanduser("~/.config/mgos/tap3.json")
SOCK = os.path.expanduser("~/.config/SYSui/runner.sock")
DEEP_FRAC = 0.42      # абсолютний поріг (частка максимуму ABS_MT_PRESSURE) для «другого кліку»
GROW = 1.18           # або: натиск виріс у стільки разів відносно моменту кліку
REARM_FRAC = 0.25     # нижче цього — натиск скинуто, можна знову

def force():
    try:
        return int(json.load(open(CFG)).get("force", 0))
    except Exception:
        return 0

def kiosk():
    s = (os.environ.get("XDG_SESSION_DESKTOP", "") + os.environ.get("XDG_CURRENT_DESKTOP", "") +
         os.environ.get("DESKTOP_SESSION", "")).lower()
    return "kiosk" in s

def toggle():
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(0.5); c.connect(SOCK); c.sendall(b"toggle\n"); c.close()
    except OSError:
        pass

def buzz():
    """Один клік-імпульс (пресет strong з mgos-haptic) — відгук на «другий клік»."""
    import subprocess
    try:
        subprocess.Popen([os.path.expanduser("~/.local/bin/mgos-haptic"), "strong"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

def find_dev():
    import evdev
    for p in evdev.list_devices():
        d = evdev.InputDevice(p)
        if d.info.vendor == 0x4C and d.info.product == 0x265:
            caps = d.capabilities().get(evdev.ecodes.EV_ABS, [])
            if any(c[0] == evdev.ecodes.ABS_MT_PRESSURE for c in caps if isinstance(c, tuple)):
                return d
    return None

def main():
    if kiosk() or force() not in (25, 50):
        return 0
    import evdev
    from evdev import ecodes as E
    dev = None
    while dev is None:                      # трекпад може підключитись пізніше (Bluetooth)
        dev = find_dev()
        if dev is None:
            time.sleep(5)
            if force() not in (25, 50): return 0
    pmax = dev.absinfo(E.ABS_MT_PRESSURE).max or 253
    pr = {}; slot = 0; three = False; pressed = False; fired = False; base = 0.0; tclick = 0.0
    last_chk = time.monotonic()
    while True:
        r, _, _ = select.select([dev.fd], [], [], 2.0)
        now = time.monotonic()
        if now - last_chk > 2.0:
            last_chk = now
            if force() not in (25, 50): return 0
        if not r: continue
        try:
            evs = list(dev.read())
        except OSError:
            return 0
        for ev in evs:
            if ev.type == E.EV_KEY:
                if ev.code == E.BTN_TOOL_TRIPLETAP:
                    three = bool(ev.value)
                elif ev.code == E.BTN_LEFT:
                    if ev.value == 1:
                        pressed = True; fired = False; base = 0.0; tclick = time.monotonic()
                        if three and force() == 25:
                            toggle(); fired = True
                    elif ev.value == 0:
                        pressed = False
            elif ev.type == E.EV_ABS:
                if ev.code == E.ABS_MT_SLOT: slot = ev.value
                elif ev.code == E.ABS_MT_TRACKING_ID and ev.value == -1: pr.pop(slot, None)
                elif ev.code == E.ABS_MT_PRESSURE: pr[slot] = ev.value
        if pressed and three and force() == 50 and pr:
            lvl = max(pr.values()) / pmax
            if time.monotonic() - tclick < 0.15: base = max(base, lvl)
            if not fired and (lvl >= DEEP_FRAC or (base > 0.12 and lvl >= base * GROW and lvl - base > 0.03)):
                toggle(); buzz(); fired = True
            elif fired and lvl < REARM_FRAC:
                fired = False

if __name__ == "__main__":
    sys.exit(main())
