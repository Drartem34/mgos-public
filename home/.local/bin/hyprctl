#!/bin/bash
# mgOS: обгортка hyprctl для Hyprland ≥ 0.57 (Lua-конфіг).
# Старі команди більше не працюють: «hyprctl dispatch workspace 2», «hyprctl keyword decoration:rounding 0».
# Перекладаємо їх у Lua-виклики з ~/.config/hypr/mgos/legacy.lua:
#   dispatch X Y   → dispatch mgosD([==[X Y]==])
#   keyword K V    → eval mgosK([==[K]==],[==[V]==])
#   --batch "a ; b" — кожну команду окремо.
# Нові команди (dispatch hl.dsp...., eval ...) і все інше — без змін.
REAL=/usr/bin/hyprctl

# Перекладаємо лише для Hyprland ≥ 0.57 (Lua). На старшому hyprlang-Hyprland старі команди рідні.
# Відповідь кешуємо на час сесії (за підписом інстансу) — без зайвого запиту на кожен виклик.
is_lua() {
    local sig=${HYPRLAND_INSTANCE_SIGNATURE:-none} c="${XDG_RUNTIME_DIR:-/tmp}/mgos-hyprlua.${HYPRLAND_INSTANCE_SIGNATURE:-none}"
    if [ ! -f "$c" ]; then
        local v; v=$("$REAL" version 2>/dev/null | grep -m1 -oE 'Hyprland [0-9]+\.[0-9]+' | grep -oE '[0-9]+\.[0-9]+')
        [ -z "$v" ] && { v=$("$REAL" version 2>/dev/null | grep -m1 -oE 'v[0-9]+\.[0-9]+' | tr -d v); }
        if [ -z "$v" ]; then return 0; fi   # невідомо (Hyprland не відповів) — нехай іде як є
        local ma=${v%%.*} mi=${v#*.}
        { [ "$ma" -gt 0 ] || [ "$mi" -ge 57 ]; } && echo 1 > "$c" || echo 0 > "$c"
    fi
    [ "$(cat "$c" 2>/dev/null)" = 1 ]
}
is_lua || exec "$REAL" "$@"

tr1() {   # одна команда рядком → перекладена
    local c="$1" head rest
    c="${c#"${c%%[![:space:]]*}"}"; c="${c%"${c##*[![:space:]]}"}"
    head=${c%% *}; rest=""; [[ $c == *" "* ]] && rest=${c#* }
    rest="${rest#"${rest%%[![:space:]]*}"}"
    case $head in
        dispatch)
            if [[ $rest == hl.* || $rest == mgosD* || -z $rest ]]; then printf '%s' "$c"
            else printf 'dispatch mgosD([==[%s]==])' "$rest"; fi ;;
        keyword)
            local k=${rest%% *} v=""; [[ $rest == *" "* ]] && v=${rest#* }
            printf 'eval mgosK([==[%s]==],[==[%s]==])' "$k" "$v" ;;
        *) printf '%s' "$c" ;;
    esac
}

flags=() batch=""
while [[ $# -gt 0 && $1 == -* && $1 != -- ]]; do
    case $1 in
        --batch) batch=$2; shift 2; continue ;;
        -i|--instance) flags+=("$1" "$2"); shift 2; continue ;;
        *) flags+=("$1") ;;
    esac
    shift
done
[[ $1 == -- ]] && shift

if [[ -n $batch ]]; then
    out=() IFS=';'; read -ra parts <<< "$batch"; unset IFS
    for p in "${parts[@]}"; do [[ -n ${p// } ]] && out+=("$(tr1 "$p")"); done
    joined=$(printf '%s ; ' "${out[@]}"); joined=${joined% ; }
    exec "$REAL" "${flags[@]}" --batch "$joined"
fi

case $1 in
    dispatch|keyword)
        t=$(tr1 "$*")
        exec "$REAL" "${flags[@]}" "${t%% *}" "${t#* }" ;;
    *) exec "$REAL" "${flags[@]}" "$@" ;;
esac
