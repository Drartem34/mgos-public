#!/usr/bin/env bash
# ============================================================================
#  mgos-quickshare — Quick Share (Samsung / Android / Windows) для mgOS
#
#    mgos-quickshare send <файл>...   надіслати на телефон/ПК поруч (без вікна;
#                                     так працює дроп файлу на годинник у топбарі)
#    mgos-quickshare open             вікно Quick Share (прийом файлів, вибір пристрою)
#    mgos-quickshare install          встановити (у терміналі, питає пароль)
#    mgos-quickshare status           installed / gui-only / missing
#
#  Основа — open-quickshare (github.com/ignotusbucius/open-quickshare, GPL-3.0):
#  Bluetooth LE + Wi-Fi LAN + Wi-Fi Direct. Акаунт Samsung/Google НЕ потрібен:
#  на телефоні в Quick Share постав видимість «Усі» (Everyone) — і ноутбук його побачить.
#
#  Рядки для топбару (stdout): STATUS|текст  PIN|1234  RESULT|файл|Finished|…  ERROR|код
# ============================================================================
set -uo pipefail
LIB="${XDG_DATA_HOME:-$HOME/.local/share}/mgos/quickshare"
SEND_BIN="$LIB/oqs-send"
REPO="https://github.com/ignotusbucius/open-quickshare.git"
REF="v0.15.2"   # перевірена версія; онови тут, щоб перейти на новішу

gui_bin() { command -v open-quickshare || command -v rquickshare || true; }

case "${1:-}" in
status)
    if [ -x "$SEND_BIN" ]; then echo installed
    elif [ -n "$(gui_bin)" ]; then echo gui-only
    else echo missing; fi
    ;;

send)
    shift
    [ $# -gt 0 ] || { echo "ERROR|nofiles"; exit 2; }
    if [ ! -x "$SEND_BIN" ]; then
        if [ -n "$(gui_bin)" ]; then
            echo "STATUS|Відкриваю Quick Share — виберіть файли у вікні"
            setsid "$(gui_bin)" >/dev/null 2>&1 &
            echo "ERROR|gui-only"; exit 4
        fi
        echo "ERROR|notinstalled"; exit 3
    fi
    # Вікно Quick Share тримає ті самі Bluetooth/mDNS — на час надсилання закриваємо його
    had_rx=""
    pgrep -x rquickshare >/dev/null || pgrep -x open-quickshare >/dev/null && had_rx=1
    pkill -x open-quickshare 2>/dev/null; pkill -x rquickshare 2>/dev/null
    # після надсилання повертаємо прийом файлів (ноут знову видно телефону)
    [ -n "$had_rx" ] && trap 'setsid "$(gui_bin)" >/dev/null 2>&1 &' EXIT
    systemctl is-active --quiet bluetooth || echo "STATUS|Bluetooth вимкнено — шукаю лише через Wi-Fi"
    bluetoothctl show 2>/dev/null | grep -q "Powered: yes" || bluetoothctl power on >/dev/null 2>&1
    echo "STATUS|Шукаю телефон… На ньому: Quick Share → «Усі» (можна «на 10 хвилин»)"
    RQS_DEVICE_NAME="${MGOS_QS_NAME:-doki · mgOS}" \
        stdbuf -oL "$SEND_BIN" "$@" 2>/dev/null | while IFS= read -r l; do
            case "$l" in
                *"PIN on both screens"*) echo "PIN|${l##*: }" ;;
                RESULT\|*) echo "$l" ;;
            esac
        done
    rc=${PIPESTATUS[0]}
    # системний звук: надіслано / помилка (Налаштування → Системні звуки)
    "$HOME/.local/bin/mgos-sound" "$([ "$rc" = 0 ] && echo message-sent-instant || echo dialog-error)" &
    exit "$rc"
    ;;

open)
    g=$(gui_bin)
    [ -n "$g" ] || { echo "ERROR|notinstalled"; exit 3; }
    setsid "$g" >/dev/null 2>&1 &
    ;;

install)
    say() { printf '\n\033[1;35m▸ %s\033[0m\n' "$*"; }
    die() { printf '\n\033[1;31m✗ %s\033[0m\n' "$*"; read -rp "Enter — закрити" _; exit 1; }
    printf '\033[1;35m━━ Quick Share для mgOS ━━\033[0m\n'
    echo "Буде встановлено open-quickshare ($REF):"
    echo "  • вікно для прийому файлів (пакет AUR open-quickshare-bin)"
    echo "  • надсилання без вікна для дропу на годинник (збирається з вихідного коду)"
    read -rp "Продовжити? [Y/n] " a
    case "${a:-y}" in [nNнН]*) exit 0 ;; esac

    say "Залежності"
    sudo pacman -S --needed --noconfirm bluez bluez-utils networkmanager rust protobuf git base-devel \
        || die "Не вдалося встановити залежності"
    sudo systemctl enable --now bluetooth.service

    say "Вікно Quick Share (AUR)"
    if command -v yay >/dev/null; then
        yay -S --needed open-quickshare-bin || echo "  (вікно не встановилось — надсилання все одно працюватиме)"
    else
        echo "  yay немає — пропускаю вікно"
    fi

    say "Надсилання для топбару (збірка ~2-5 хв)"
    tmp=$(mktemp -d)
    git clone --depth 1 --branch "$REF" "$REPO" "$tmp/oqs" || die "Немає зв'язку з GitHub"
    ( cd "$tmp/oqs/core_lib" && cargo build --release --example app_send ) || die "Збірка не вдалася"
    mkdir -p "$LIB"
    install -m755 "$tmp/oqs/core_lib/target/release/examples/app_send" "$SEND_BIN"
    rm -rf "$tmp"

    if systemctl is-active --quiet firewalld; then
        say "Брандмауер: дозволяю Quick Share у локальній мережі"
        sudo firewall-cmd --permanent --add-service=mdns >/dev/null 2>&1
        sudo firewall-cmd --reload >/dev/null 2>&1
    fi
    say "Готово! Перетягніть файл на годинник у топбарі."
    echo "На телефоні: Quick Share → видимість «Усі» (Everyone), Bluetooth і Wi-Fi увімкнені."
    read -rp "Enter — закрити" _
    ;;

*)
    sed -n '3,16p' "$0" | sed 's/^#  \{0,1\}//'
    ;;
esac
