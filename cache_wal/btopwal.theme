# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0c181d"

# Main text color
theme[main_fg]="#c2c5c6"

# Title color for boxes
theme[title]="#c2c5c6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#3A4B60"

# Background color of selected item in processes box
theme[selected_bg]="#424EC2"

# Foreground color of selected item in processes box
theme[selected_fg]="#c2c5c6"

# Color of inactive/disabled text
theme[inactive_fg]="#919394"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c2c5c6"

# Background color of the percentage meters
theme[meter_bg]="#1b3641"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#1F3997"

# Cpu box outline color
theme[cpu_box]="#24439C"

# Memory/disks box outline color
theme[mem_box]="#7C8CF1"

# Net up/down box outline color
theme[net_box]="#1F3997"

# Processes box outline color
theme[proc_box]="#939EF8"

# Box divider line and small boxes line color
theme[div_line]="#3c464a"

# Temperature graph colors
theme[temp_start]="#24439C"
theme[temp_mid]="#7C8CF1"
theme[temp_end]="#939EF8"

# CPU graph colors
theme[cpu_start]="#24439C"
theme[cpu_mid]="#7C8CF1"
theme[cpu_end]="#939EF8"

# Mem/Disk free meter
theme[free_start]="#24439C"
theme[free_mid]="#7C8CF1"
theme[free_end]="#939EF8"

# Mem/Disk cached meter
theme[cached_start]="#24439C"
theme[cached_mid]="#7C8CF1"
theme[cached_end]="#939EF8"

# Mem/Disk available meter
theme[available_start]="#24439C"
theme[available_mid]="#7C8CF1"
theme[available_end]="#939EF8"

# Mem/Disk used meter
theme[used_start]="#24439C"
theme[used_mid]="#7C8CF1"
theme[used_end]="#939EF8"

# Download graph colors
theme[download_start]="#24439C"
theme[download_mid]="#7C8CF1"
theme[download_end]="#939EF8"

# Upload graph colors
theme[upload_start]="#24439C"
theme[upload_mid]="#7C8CF1"
theme[upload_end]="#939EF8"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#24439C"
theme[process_mid]="#7C8CF1"
theme[process_end]="#939EF8"
