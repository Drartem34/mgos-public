# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1f2024"

# Main text color
theme[main_fg]="#c7c7c8"

# Title color for boxes
theme[title]="#c7c7c8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#679CDE"

# Background color of selected item in processes box
theme[selected_bg]="#94A3BA"

# Foreground color of selected item in processes box
theme[selected_fg]="#c7c7c8"

# Color of inactive/disabled text
theme[inactive_fg]="#959596"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c7c7c8"

# Background color of the percentage meters
theme[meter_bg]="#454851"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#9C9CA6"

# Cpu box outline color
theme[cpu_box]="#8A98B0"

# Memory/disks box outline color
theme[mem_box]="#99AAC6"

# Net up/down box outline color
theme[net_box]="#9C9CA6"

# Processes box outline color
theme[proc_box]="#AAB6CE"

# Box divider line and small boxes line color
theme[div_line]="#4b4c4f"

# Temperature graph colors
theme[temp_start]="#8A98B0"
theme[temp_mid]="#99AAC6"
theme[temp_end]="#AAB6CE"

# CPU graph colors
theme[cpu_start]="#8A98B0"
theme[cpu_mid]="#99AAC6"
theme[cpu_end]="#AAB6CE"

# Mem/Disk free meter
theme[free_start]="#8A98B0"
theme[free_mid]="#99AAC6"
theme[free_end]="#AAB6CE"

# Mem/Disk cached meter
theme[cached_start]="#8A98B0"
theme[cached_mid]="#99AAC6"
theme[cached_end]="#AAB6CE"

# Mem/Disk available meter
theme[available_start]="#8A98B0"
theme[available_mid]="#99AAC6"
theme[available_end]="#AAB6CE"

# Mem/Disk used meter
theme[used_start]="#8A98B0"
theme[used_mid]="#99AAC6"
theme[used_end]="#AAB6CE"

# Download graph colors
theme[download_start]="#8A98B0"
theme[download_mid]="#99AAC6"
theme[download_end]="#AAB6CE"

# Upload graph colors
theme[upload_start]="#8A98B0"
theme[upload_mid]="#99AAC6"
theme[upload_end]="#AAB6CE"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#8A98B0"
theme[process_mid]="#99AAC6"
theme[process_end]="#AAB6CE"
