# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#392e38"

# Main text color
theme[main_fg]="#cdcacd"

# Title color for boxes
theme[title]="#cdcacd"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#51CFF6"

# Background color of selected item in processes box
theme[selected_bg]="#9DDBF5"

# Foreground color of selected item in processes box
theme[selected_fg]="#cdcacd"

# Color of inactive/disabled text
theme[inactive_fg]="#999799"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#cdcacd"

# Background color of the percentage meters
theme[meter_bg]="#80677e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#71D2F5"

# Cpu box outline color
theme[cpu_box]="#A4B6D7"

# Memory/disks box outline color
theme[mem_box]="#ACD7F5"

# Net up/down box outline color
theme[net_box]="#71D2F5"

# Processes box outline color
theme[proc_box]="#E9D3E0"

# Box divider line and small boxes line color
theme[div_line]="#60575f"

# Temperature graph colors
theme[temp_start]="#A4B6D7"
theme[temp_mid]="#ACD7F5"
theme[temp_end]="#E9D3E0"

# CPU graph colors
theme[cpu_start]="#A4B6D7"
theme[cpu_mid]="#ACD7F5"
theme[cpu_end]="#E9D3E0"

# Mem/Disk free meter
theme[free_start]="#A4B6D7"
theme[free_mid]="#ACD7F5"
theme[free_end]="#E9D3E0"

# Mem/Disk cached meter
theme[cached_start]="#A4B6D7"
theme[cached_mid]="#ACD7F5"
theme[cached_end]="#E9D3E0"

# Mem/Disk available meter
theme[available_start]="#A4B6D7"
theme[available_mid]="#ACD7F5"
theme[available_end]="#E9D3E0"

# Mem/Disk used meter
theme[used_start]="#A4B6D7"
theme[used_mid]="#ACD7F5"
theme[used_end]="#E9D3E0"

# Download graph colors
theme[download_start]="#A4B6D7"
theme[download_mid]="#ACD7F5"
theme[download_end]="#E9D3E0"

# Upload graph colors
theme[upload_start]="#A4B6D7"
theme[upload_mid]="#ACD7F5"
theme[upload_end]="#E9D3E0"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#A4B6D7"
theme[process_mid]="#ACD7F5"
theme[process_end]="#E9D3E0"
