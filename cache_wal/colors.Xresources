! X colors.
! Generated by 'wal'
*foreground:        #c3c5c8
*background:        #0f1724
*.foreground:       #c3c5c8
*.background:       #0f1724
emacs*foreground:   #c3c5c8
emacs*background:   #0f1724
URxvt*foreground:   #c3c5c8
XTerm*foreground:   #c3c5c8
UXTerm*foreground:  #c3c5c8
URxvt*background:   [100]#0f1724
XTerm*background:   #0f1724
UXTerm*background:  #0f1724
URxvt*cursorColor:  #c3c5c8
XTerm*cursorColor:  #c3c5c8
UXTerm*cursorColor: #c3c5c8
URxvt*borderColor:  [100]#0f1724

! Colors 0-15.
*.color0: #0f1724
*color0:  #0f1724
*.color1: #4D4D6B
*color1:  #4D4D6B
*.color2: #4F3D8A
*color2:  #4F3D8A
*.color3: #5D419C
*color3:  #5D419C
*.color4: #746495
*color4:  #746495
*.color5: #6243A3
*color5:  #6243A3
*.color6: #877C99
*color6:  #877C99
*.color7: #c3c5c8
*color7:  #c3c5c8
*.color8: #5e6774
*color8:  #5e6774
*.color9: #4D4D6B
*color9:  #4D4D6B
*.color10: #4F3D8A
*color10:  #4F3D8A
*.color11: #5D419C
*color11:  #5D419C
*.color12: #746495
*color12:  #746495
*.color13: #6243A3
*color13:  #6243A3
*.color14: #877C99
*color14:  #877C99
*.color15: #c3c5c8
*color15:  #c3c5c8

! Black color that will not be affected by bold highlighting.
*.color66: #0f1724
*color66:  #0f1724

! Xclock colors.
XClock*foreground: #c3c5c8
XClock*background: #0f1724
XClock*majorColor:  rgba:c3/c5/c8/ff
XClock*minorColor:  rgba:c3/c5/c8/ff
XClock*hourColor:   rgba:c3/c5/c8/ff
XClock*minuteColor: rgba:c3/c5/c8/ff
XClock*secondColor: rgba:c3/c5/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
