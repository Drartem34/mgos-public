! X colors.
! Generated by 'wal'
*foreground:        #c8c8d8
*background:        #242563
*.foreground:       #c8c8d8
*.background:       #242563
emacs*foreground:   #c8c8d8
emacs*background:   #242563
URxvt*foreground:   #c8c8d8
XTerm*foreground:   #c8c8d8
UXTerm*foreground:  #c8c8d8
URxvt*background:   [100]#242563
XTerm*background:   #242563
UXTerm*background:  #242563
URxvt*cursorColor:  #c8c8d8
XTerm*cursorColor:  #c8c8d8
UXTerm*cursorColor: #c8c8d8
URxvt*borderColor:  [100]#242563

! Colors 0-15.
*.color0: #242563
*color0:  #242563
*.color1: #C57AC4
*color1:  #C57AC4
*.color2: #A49AEA
*color2:  #A49AEA
*.color3: #CF8BD3
*color3:  #CF8BD3
*.color4: #DCA5E8
*color4:  #DCA5E8
*.color5: #ABC5EA
*color5:  #ABC5EA
*.color6: #D3D2FD
*color6:  #D3D2FD
*.color7: #c8c8d8
*color7:  #c8c8d8
*.color8: #787890
*color8:  #787890
*.color9: #C57AC4
*color9:  #C57AC4
*.color10: #A49AEA
*color10:  #A49AEA
*.color11: #CF8BD3
*color11:  #CF8BD3
*.color12: #DCA5E8
*color12:  #DCA5E8
*.color13: #ABC5EA
*color13:  #ABC5EA
*.color14: #D3D2FD
*color14:  #D3D2FD
*.color15: #c8c8d8
*color15:  #c8c8d8

! Black color that will not be affected by bold highlighting.
*.color66: #242563
*color66:  #242563

! Xclock colors.
XClock*foreground: #c8c8d8
XClock*background: #242563
XClock*majorColor:  rgba:c8/c8/d8/ff
XClock*minorColor:  rgba:c8/c8/d8/ff
XClock*hourColor:   rgba:c8/c8/d8/ff
XClock*minuteColor: rgba:c8/c8/d8/ff
XClock*secondColor: rgba:c8/c8/d8/ff

! Set depth to make transparency work.
URxvt*depth: 32
