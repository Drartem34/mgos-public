! X colors.
! Generated by 'wal'
*foreground:        #c7c7c8
*background:        #1f2024
*.foreground:       #c7c7c8
*.background:       #1f2024
emacs*foreground:   #c7c7c8
emacs*background:   #1f2024
URxvt*foreground:   #c7c7c8
XTerm*foreground:   #c7c7c8
UXTerm*foreground:  #c7c7c8
URxvt*background:   [100]#1f2024
XTerm*background:   #1f2024
UXTerm*background:  #1f2024
URxvt*cursorColor:  #c7c7c8
XTerm*cursorColor:  #c7c7c8
UXTerm*cursorColor: #c7c7c8
URxvt*borderColor:  [100]#1f2024

! Colors 0-15.
*.color0: #1f2024
*color0:  #1f2024
*.color1: #679CDE
*color1:  #679CDE
*.color2: #9C9CA6
*color2:  #9C9CA6
*.color3: #8A98B0
*color3:  #8A98B0
*.color4: #94A3BA
*color4:  #94A3BA
*.color5: #99AAC6
*color5:  #99AAC6
*.color6: #AAB6CE
*color6:  #AAB6CE
*.color7: #c7c7c8
*color7:  #c7c7c8
*.color8: #636a79
*color8:  #636a79
*.color9: #679CDE
*color9:  #679CDE
*.color10: #9C9CA6
*color10:  #9C9CA6
*.color11: #8A98B0
*color11:  #8A98B0
*.color12: #94A3BA
*color12:  #94A3BA
*.color13: #99AAC6
*color13:  #99AAC6
*.color14: #AAB6CE
*color14:  #AAB6CE
*.color15: #c7c7c8
*color15:  #c7c7c8

! Black color that will not be affected by bold highlighting.
*.color66: #1f2024
*color66:  #1f2024

! Xclock colors.
XClock*foreground: #c7c7c8
XClock*background: #1f2024
XClock*majorColor:  rgba:c7/c7/c8/ff
XClock*minorColor:  rgba:c7/c7/c8/ff
XClock*hourColor:   rgba:c7/c7/c8/ff
XClock*minuteColor: rgba:c7/c7/c8/ff
XClock*secondColor: rgba:c7/c7/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
