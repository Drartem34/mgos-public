! X colors.
! Generated by 'wal'
*foreground:        #cdcacd
*background:        #392e38
*.foreground:       #cdcacd
*.background:       #392e38
emacs*foreground:   #cdcacd
emacs*background:   #392e38
URxvt*foreground:   #cdcacd
XTerm*foreground:   #cdcacd
UXTerm*foreground:  #cdcacd
URxvt*background:   [100]#392e38
XTerm*background:   #392e38
UXTerm*background:  #392e38
URxvt*cursorColor:  #cdcacd
XTerm*cursorColor:  #cdcacd
UXTerm*cursorColor: #cdcacd
URxvt*borderColor:  [100]#392e38

! Colors 0-15.
*.color0: #392e38
*color0:  #392e38
*.color1: #51CFF6
*color1:  #51CFF6
*.color2: #71D2F5
*color2:  #71D2F5
*.color3: #A4B6D7
*color3:  #A4B6D7
*.color4: #9DDBF5
*color4:  #9DDBF5
*.color5: #ACD7F5
*color5:  #ACD7F5
*.color6: #E9D3E0
*color6:  #E9D3E0
*.color7: #cdcacd
*color7:  #cdcacd
*.color8: #866e83
*color8:  #866e83
*.color9: #51CFF6
*color9:  #51CFF6
*.color10: #71D2F5
*color10:  #71D2F5
*.color11: #A4B6D7
*color11:  #A4B6D7
*.color12: #9DDBF5
*color12:  #9DDBF5
*.color13: #ACD7F5
*color13:  #ACD7F5
*.color14: #E9D3E0
*color14:  #E9D3E0
*.color15: #cdcacd
*color15:  #cdcacd

! Black color that will not be affected by bold highlighting.
*.color66: #392e38
*color66:  #392e38

! Xclock colors.
XClock*foreground: #cdcacd
XClock*background: #392e38
XClock*majorColor:  rgba:cd/ca/cd/ff
XClock*minorColor:  rgba:cd/ca/cd/ff
XClock*hourColor:   rgba:cd/ca/cd/ff
XClock*minuteColor: rgba:cd/ca/cd/ff
XClock*secondColor: rgba:cd/ca/cd/ff

! Set depth to make transparency work.
URxvt*depth: 32
