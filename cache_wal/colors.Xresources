! X colors.
! Generated by 'wal'
*foreground:        #c2c5c6
*background:        #0c181d
*.foreground:       #c2c5c6
*.background:       #0c181d
emacs*foreground:   #c2c5c6
emacs*background:   #0c181d
URxvt*foreground:   #c2c5c6
XTerm*foreground:   #c2c5c6
UXTerm*foreground:  #c2c5c6
URxvt*background:   [100]#0c181d
XTerm*background:   #0c181d
UXTerm*background:  #0c181d
URxvt*cursorColor:  #c2c5c6
XTerm*cursorColor:  #c2c5c6
UXTerm*cursorColor: #c2c5c6
URxvt*borderColor:  [100]#0c181d

! Colors 0-15.
*.color0: #0c181d
*color0:  #0c181d
*.color1: #3A4B60
*color1:  #3A4B60
*.color2: #1F3997
*color2:  #1F3997
*.color3: #24439C
*color3:  #24439C
*.color4: #424EC2
*color4:  #424EC2
*.color5: #7C8CF1
*color5:  #7C8CF1
*.color6: #939EF8
*color6:  #939EF8
*.color7: #c2c5c6
*color7:  #c2c5c6
*.color8: #5c6970
*color8:  #5c6970
*.color9: #3A4B60
*color9:  #3A4B60
*.color10: #1F3997
*color10:  #1F3997
*.color11: #24439C
*color11:  #24439C
*.color12: #424EC2
*color12:  #424EC2
*.color13: #7C8CF1
*color13:  #7C8CF1
*.color14: #939EF8
*color14:  #939EF8
*.color15: #c2c5c6
*color15:  #c2c5c6

! Black color that will not be affected by bold highlighting.
*.color66: #0c181d
*color66:  #0c181d

! Xclock colors.
XClock*foreground: #c2c5c6
XClock*background: #0c181d
XClock*majorColor:  rgba:c2/c5/c6/ff
XClock*minorColor:  rgba:c2/c5/c6/ff
XClock*hourColor:   rgba:c2/c5/c6/ff
XClock*minuteColor: rgba:c2/c5/c6/ff
XClock*secondColor: rgba:c2/c5/c6/ff

! Set depth to make transparency work.
URxvt*depth: 32
