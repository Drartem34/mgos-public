! X colors.
! Generated by 'wal'
*foreground:        #c3ccf0
*background:        #0B0917
*.foreground:       #c3ccf0
*.background:       #0B0917
emacs*foreground:   #c3ccf0
emacs*background:   #0B0917
URxvt*foreground:   #c3ccf0
XTerm*foreground:   #c3ccf0
UXTerm*foreground:  #c3ccf0
URxvt*background:   [100]#0B0917
XTerm*background:   #0B0917
UXTerm*background:  #0B0917
URxvt*cursorColor:  #c3ccf0
XTerm*cursorColor:  #c3ccf0
UXTerm*cursorColor: #c3ccf0
URxvt*borderColor:  [100]#0B0917

! Colors 0-15.
*.color0: #0B0917
*color0:  #0B0917
*.color1: #394595
*color1:  #394595
*.color2: #4F50A7
*color2:  #4F50A7
*.color3: #6074D8
*color3:  #6074D8
*.color4: #817EDF
*color4:  #817EDF
*.color5: #7882B7
*color5:  #7882B7
*.color6: #6F89E9
*color6:  #6F89E9
*.color7: #c3ccf0
*color7:  #c3ccf0
*.color8: #888ea8
*color8:  #888ea8
*.color9: #394595
*color9:  #394595
*.color10: #4F50A7
*color10:  #4F50A7
*.color11: #6074D8
*color11:  #6074D8
*.color12: #817EDF
*color12:  #817EDF
*.color13: #7882B7
*color13:  #7882B7
*.color14: #6F89E9
*color14:  #6F89E9
*.color15: #c3ccf0
*color15:  #c3ccf0

! Black color that will not be affected by bold highlighting.
*.color66: #0B0917
*color66:  #0B0917

! Xclock colors.
XClock*foreground: #c3ccf0
XClock*background: #0B0917
XClock*majorColor:  rgba:c3/cc/f0/ff
XClock*minorColor:  rgba:c3/cc/f0/ff
XClock*hourColor:   rgba:c3/cc/f0/ff
XClock*minuteColor: rgba:c3/cc/f0/ff
XClock*secondColor: rgba:c3/cc/f0/ff

! Set depth to make transparency work.
URxvt*depth: 32
