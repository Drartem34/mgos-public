{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#1f202490",
                "editor.background": "#1f202490",
                "editor.foreground": "#c7c7c8",
                "text": "#c7c7c8",
                "text.muted": "#c7c7c870",
                "text.ignored": "#c7c7c840",
                "text.placeholder": "#c7c7c850",
                "ignored": "#c7c7c830",
                "element.hover": "#c7c7c830",
                "ghost_element.hover": "#679CDE30",
                "ghost_element.selected": "#679CDE30",
                "ghost_element.active": "#679CDE60",
                "border": "#1f2024",
                "editor.highlighted_line.background": "#679CDE10",
                "editor.active_line.background": "#679CDE10",
                "panel.background": "#1f202490",
                "title_bar.background": "#1f202490",
                "title_bar.inactive_background": "#1f202490",
                "status_bar.background": "#1f202490",
                "drop_target.background": "#1f202490",
                "elevated_surface.background": "#1f2024",
                "toolbar.background": "#1f202490",
                "tab_bar.background": "#1f202490",
                "tab.inactive_background": "#1f202490",
                "tab.active_background": "#679CDE30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#1f2024",
                "scrollbar.thumb.background": "#679CDE",
                "editor.gutter.background": "#1f202490",
                "terminal.background": "#1f202410",
                "terminal.foreground": "#c7c7c8",
                "terminal.dim_foreground": "#c7c7c8",
                "terminal.bright_foreground": "#c7c7c8",
                "terminal.ansi.black": "#1f2024",
                "terminal.ansi.red": "#679CDE",
                "terminal.ansi.green": "#9C9CA6",
                "terminal.ansi.yellow": "#8A98B0",
                "terminal.ansi.blue": "#94A3BA",
                "terminal.ansi.magenta": "#99AAC6",
                "terminal.ansi.cyan": "#AAB6CE",
                "terminal.ansi.white": "#c7c7c8",
                "terminal.ansi.bright_black": "#636a79",
                "terminal.ansi.bright_red": "#679CDE",
                "terminal.ansi.bright_green": "#9C9CA6",
                "terminal.ansi.bright_yellow": "#8A98B0",
                "terminal.ansi.bright_blue": "#94A3BA",
                "terminal.ansi.bright_magenta": "#99AAC6",
                "terminal.ansi.bright_cyan": "#AAB6CE",
                "terminal.ansi.bright_white": "#c7c7c8",
                "modified": "#679CDE",
                "syntax": {
                    "attribute": {
                        "color": "#679CDE"
                    },
                    "boolean": {
                      "color": "#9C9CA6"
                    },
                    "comment": {
                      "color": "#636a79"
                    },
                    "comment.doc": {
                      "color": "#636a79"
                    },
                    "constant": {
                      "color": "#9C9CA6"
                    },
                    "function": {
                      "color": "#AAB6CE"
                    },
                    "keyword": {
                      "color": "#94A3BA"
                    },
                    "number": {
                      "color": "#99AAC6"
                    },
                    "operator": {
                      "color": "#94A3BA"
                    },
                    "string": {
                      "color": "#679CDE"
                    },
                    "variable": {
                      "color": "#9C9CA6"
                    }
                },
                "players": [
                  {
                    "cursor": "#679CDE",
                    "background": "#1f2024",
                    "selection": "#679CDE30"
                  }
                ]
            }
        }
    ]
}
