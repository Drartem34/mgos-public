{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#392e3890",
                "editor.background": "#392e3890",
                "editor.foreground": "#cdcacd",
                "text": "#cdcacd",
                "text.muted": "#cdcacd70",
                "text.ignored": "#cdcacd40",
                "text.placeholder": "#cdcacd50",
                "ignored": "#cdcacd30",
                "element.hover": "#cdcacd30",
                "ghost_element.hover": "#51CFF630",
                "ghost_element.selected": "#51CFF630",
                "ghost_element.active": "#51CFF660",
                "border": "#392e38",
                "editor.highlighted_line.background": "#51CFF610",
                "editor.active_line.background": "#51CFF610",
                "panel.background": "#392e3890",
                "title_bar.background": "#392e3890",
                "title_bar.inactive_background": "#392e3890",
                "status_bar.background": "#392e3890",
                "drop_target.background": "#392e3890",
                "elevated_surface.background": "#392e38",
                "toolbar.background": "#392e3890",
                "tab_bar.background": "#392e3890",
                "tab.inactive_background": "#392e3890",
                "tab.active_background": "#51CFF630",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#392e38",
                "scrollbar.thumb.background": "#51CFF6",
                "editor.gutter.background": "#392e3890",
                "terminal.background": "#392e3810",
                "terminal.foreground": "#cdcacd",
                "terminal.dim_foreground": "#cdcacd",
                "terminal.bright_foreground": "#cdcacd",
                "terminal.ansi.black": "#392e38",
                "terminal.ansi.red": "#51CFF6",
                "terminal.ansi.green": "#71D2F5",
                "terminal.ansi.yellow": "#A4B6D7",
                "terminal.ansi.blue": "#9DDBF5",
                "terminal.ansi.magenta": "#ACD7F5",
                "terminal.ansi.cyan": "#E9D3E0",
                "terminal.ansi.white": "#cdcacd",
                "terminal.ansi.bright_black": "#866e83",
                "terminal.ansi.bright_red": "#51CFF6",
                "terminal.ansi.bright_green": "#71D2F5",
                "terminal.ansi.bright_yellow": "#A4B6D7",
                "terminal.ansi.bright_blue": "#9DDBF5",
                "terminal.ansi.bright_magenta": "#ACD7F5",
                "terminal.ansi.bright_cyan": "#E9D3E0",
                "terminal.ansi.bright_white": "#cdcacd",
                "modified": "#51CFF6",
                "syntax": {
                    "attribute": {
                        "color": "#51CFF6"
                    },
                    "boolean": {
                      "color": "#71D2F5"
                    },
                    "comment": {
                      "color": "#866e83"
                    },
                    "comment.doc": {
                      "color": "#866e83"
                    },
                    "constant": {
                      "color": "#71D2F5"
                    },
                    "function": {
                      "color": "#E9D3E0"
                    },
                    "keyword": {
                      "color": "#9DDBF5"
                    },
                    "number": {
                      "color": "#ACD7F5"
                    },
                    "operator": {
                      "color": "#9DDBF5"
                    },
                    "string": {
                      "color": "#51CFF6"
                    },
                    "variable": {
                      "color": "#71D2F5"
                    }
                },
                "players": [
                  {
                    "cursor": "#51CFF6",
                    "background": "#392e38",
                    "selection": "#51CFF630"
                  }
                ]
            }
        }
    ]
}
