{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0f172490",
                "editor.background": "#0f172490",
                "editor.foreground": "#c3c5c8",
                "text": "#c3c5c8",
                "text.muted": "#c3c5c870",
                "text.ignored": "#c3c5c840",
                "text.placeholder": "#c3c5c850",
                "ignored": "#c3c5c830",
                "element.hover": "#c3c5c830",
                "ghost_element.hover": "#4D4D6B30",
                "ghost_element.selected": "#4D4D6B30",
                "ghost_element.active": "#4D4D6B60",
                "border": "#0f1724",
                "editor.highlighted_line.background": "#4D4D6B10",
                "editor.active_line.background": "#4D4D6B10",
                "panel.background": "#0f172490",
                "title_bar.background": "#0f172490",
                "title_bar.inactive_background": "#0f172490",
                "status_bar.background": "#0f172490",
                "drop_target.background": "#0f172490",
                "elevated_surface.background": "#0f1724",
                "toolbar.background": "#0f172490",
                "tab_bar.background": "#0f172490",
                "tab.inactive_background": "#0f172490",
                "tab.active_background": "#4D4D6B30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0f1724",
                "scrollbar.thumb.background": "#4D4D6B",
                "editor.gutter.background": "#0f172490",
                "terminal.background": "#0f172410",
                "terminal.foreground": "#c3c5c8",
                "terminal.dim_foreground": "#c3c5c8",
                "terminal.bright_foreground": "#c3c5c8",
                "terminal.ansi.black": "#0f1724",
                "terminal.ansi.red": "#4D4D6B",
                "terminal.ansi.green": "#4F3D8A",
                "terminal.ansi.yellow": "#5D419C",
                "terminal.ansi.blue": "#746495",
                "terminal.ansi.magenta": "#6243A3",
                "terminal.ansi.cyan": "#877C99",
                "terminal.ansi.white": "#c3c5c8",
                "terminal.ansi.bright_black": "#5e6774",
                "terminal.ansi.bright_red": "#4D4D6B",
                "terminal.ansi.bright_green": "#4F3D8A",
                "terminal.ansi.bright_yellow": "#5D419C",
                "terminal.ansi.bright_blue": "#746495",
                "terminal.ansi.bright_magenta": "#6243A3",
                "terminal.ansi.bright_cyan": "#877C99",
                "terminal.ansi.bright_white": "#c3c5c8",
                "modified": "#4D4D6B",
                "syntax": {
                    "attribute": {
                        "color": "#4D4D6B"
                    },
                    "boolean": {
                      "color": "#4F3D8A"
                    },
                    "comment": {
                      "color": "#5e6774"
                    },
                    "comment.doc": {
                      "color": "#5e6774"
                    },
                    "constant": {
                      "color": "#4F3D8A"
                    },
                    "function": {
                      "color": "#877C99"
                    },
                    "keyword": {
                      "color": "#746495"
                    },
                    "number": {
                      "color": "#6243A3"
                    },
                    "operator": {
                      "color": "#746495"
                    },
                    "string": {
                      "color": "#4D4D6B"
                    },
                    "variable": {
                      "color": "#4F3D8A"
                    }
                },
                "players": [
                  {
                    "cursor": "#4D4D6B",
                    "background": "#0f1724",
                    "selection": "#4D4D6B30"
                  }
                ]
            }
        }
    ]
}
