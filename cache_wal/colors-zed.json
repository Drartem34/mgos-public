{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#24256390",
                "editor.background": "#24256390",
                "editor.foreground": "#c8c8d8",
                "text": "#c8c8d8",
                "text.muted": "#c8c8d870",
                "text.ignored": "#c8c8d840",
                "text.placeholder": "#c8c8d850",
                "ignored": "#c8c8d830",
                "element.hover": "#c8c8d830",
                "ghost_element.hover": "#C57AC430",
                "ghost_element.selected": "#C57AC430",
                "ghost_element.active": "#C57AC460",
                "border": "#242563",
                "editor.highlighted_line.background": "#C57AC410",
                "editor.active_line.background": "#C57AC410",
                "panel.background": "#24256390",
                "title_bar.background": "#24256390",
                "title_bar.inactive_background": "#24256390",
                "status_bar.background": "#24256390",
                "drop_target.background": "#24256390",
                "elevated_surface.background": "#242563",
                "toolbar.background": "#24256390",
                "tab_bar.background": "#24256390",
                "tab.inactive_background": "#24256390",
                "tab.active_background": "#C57AC430",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#242563",
                "scrollbar.thumb.background": "#C57AC4",
                "editor.gutter.background": "#24256390",
                "terminal.background": "#24256310",
                "terminal.foreground": "#c8c8d8",
                "terminal.dim_foreground": "#c8c8d8",
                "terminal.bright_foreground": "#c8c8d8",
                "terminal.ansi.black": "#242563",
                "terminal.ansi.red": "#C57AC4",
                "terminal.ansi.green": "#A49AEA",
                "terminal.ansi.yellow": "#CF8BD3",
                "terminal.ansi.blue": "#DCA5E8",
                "terminal.ansi.magenta": "#ABC5EA",
                "terminal.ansi.cyan": "#D3D2FD",
                "terminal.ansi.white": "#c8c8d8",
                "terminal.ansi.bright_black": "#787890",
                "terminal.ansi.bright_red": "#C57AC4",
                "terminal.ansi.bright_green": "#A49AEA",
                "terminal.ansi.bright_yellow": "#CF8BD3",
                "terminal.ansi.bright_blue": "#DCA5E8",
                "terminal.ansi.bright_magenta": "#ABC5EA",
                "terminal.ansi.bright_cyan": "#D3D2FD",
                "terminal.ansi.bright_white": "#c8c8d8",
                "modified": "#C57AC4",
                "syntax": {
                    "attribute": {
                        "color": "#C57AC4"
                    },
                    "boolean": {
                      "color": "#A49AEA"
                    },
                    "comment": {
                      "color": "#787890"
                    },
                    "comment.doc": {
                      "color": "#787890"
                    },
                    "constant": {
                      "color": "#A49AEA"
                    },
                    "function": {
                      "color": "#D3D2FD"
                    },
                    "keyword": {
                      "color": "#DCA5E8"
                    },
                    "number": {
                      "color": "#ABC5EA"
                    },
                    "operator": {
                      "color": "#DCA5E8"
                    },
                    "string": {
                      "color": "#C57AC4"
                    },
                    "variable": {
                      "color": "#A49AEA"
                    }
                },
                "players": [
                  {
                    "cursor": "#C57AC4",
                    "background": "#242563",
                    "selection": "#C57AC430"
                  }
                ]
            }
        }
    ]
}
