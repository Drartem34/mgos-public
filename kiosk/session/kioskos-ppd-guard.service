[Unit]
Description=kioskOS: повернути профіль живлення, якщо ПК вимкнули з kiosk-сесії
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service
ConditionDirectoryNotEmpty=/var/lib/kioskos

[Service]
Type=oneshot
# при завантаженні kiosk ще не запущений — будь-який збережений профіль означає, що його не повернули
ExecStart=/bin/sh -c 'for f in /var/lib/kioskos/*.ppd; do [ -f "$f" ] || continue; p=$(cat "$f"); [ -n "$p" ] && powerprofilesctl set "$p" && rm -f "$f"; done; true'

[Install]
WantedBy=multi-user.target
