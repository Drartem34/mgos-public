#!/usr/bin/env bash
# ============================================================================
#  kioskos-mode — перемикач «kiosk ↔ звичайна система» для співіснування з mgOS
#
#  Усе, що kioskOS змінює глобально (профіль живлення, GTK-тема, gsettings,
#  маска localsearch, Google Drive), вмикається ЛИШЕ на час kiosk-сесії і
#  повертається як було при виході. Тож mgOS (чи будь-яка інша сесія) працює
#  на повній потужності і зі своєю темою.
#
#    kioskos-mode enter <pid>  — перед стартом kiosk (викликає kiosk-session)
#    kioskos-mode leave        — після виходу з kiosk
#    kioskos-mode guard        — при вході в будь-яку сесію: якщо kiosk впав/
#                                ПК вимкнули з kiosk — повернути все як було
#    kioskos-mode status       — показати стан
# ============================================================================
set -u
ST="${XDG_STATE_HOME:-$HOME/.local/state}/kioskos"
SESS="$HOME/.config/hyprland/kioskOS/session"   # що вмикати в kiosk (ставить інсталятор)
PPD_DIR=/var/lib/kioskos                         # профіль живлення до kiosk (для відновлення при завантаженні)
PPD_FILE="$PPD_DIR/$(id -un).ppd"
GTK_FILES=(gtk-3.0/gtk.css gtk-3.0/settings.ini gtk-4.0/gtk.css gtk-4.0/gtk-dark.css gtk-4.0/settings.ini)
LOCALSEARCH=(localsearch-3.service localsearch-control-3.service localsearch-writeback-3.service)
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

mkdir -p "$ST"
exec 9>"$ST/lock"
flock 9

active_pid() { local p; p=$(cat "$ST/active" 2>/dev/null) || return 1; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
stale()      { [ -f "$ST/active" ] && ! active_pid; }
gs()         { gsettings "$@" 2>/dev/null; }

do_leave() {
    [ -f "$ST/active" ] || return 0
    # 1) GTK-файли mgOS назад
    if [ -d "$ST/gtk" ]; then
        local f
        for f in "${GTK_FILES[@]}"; do
            rm -f "$CFG/$f"
            if [ -e "$ST/gtk/$f" ] || [ -L "$ST/gtk/$f" ]; then mkdir -p "$CFG/$(dirname "$f")"; cp -a "$ST/gtk/$f" "$CFG/$f"; fi
        done
        rm -rf "$ST/gtk"
    fi
    # 2) gsettings mgOS назад
    if [ -f "$ST/gsettings.saved" ]; then
        local schema key value
        while read -r schema key value; do
            [ -n "$key" ] || continue
            if [ "$value" = "@default" ]; then gs reset "$schema" "$key"; else gs set "$schema" "$key" "$value"; fi
        done < "$ST/gsettings.saved"
        rm -f "$ST/gsettings.saved"
    fi
    # 3) localsearch знову дозволено (маска була лише --runtime)
    systemctl --user unmask --runtime "${LOCALSEARCH[@]}" >/dev/null 2>&1
    # 4) Google Drive kiosk-сервісу — зупинити, щоб інша сесія змонтувала своїм способом
    if [ -f "$ST/gdrive.started" ]; then
        systemctl --user stop rclone-gdrive.service >/dev/null 2>&1
        rm -f "$ST/gdrive.started"
    fi
    # 5) профіль живлення, який був до kiosk
    if [ -f "$PPD_FILE" ]; then
        local prev; prev=$(cat "$PPD_FILE")
        if [ -n "$prev" ] && [ "$(powerprofilesctl get 2>/dev/null)" != "$prev" ]; then
            powerprofilesctl set "$prev" 2>/dev/null   # не вийшло (не активна сесія) — поверне kioskos-ppd-guard при завантаженні
        fi
        [ "$(powerprofilesctl get 2>/dev/null)" = "$prev" ] && rm -f "$PPD_FILE"
    fi
    rm -f "$ST/active"
}

do_enter() {
    local pid=${1:-$PPID}
    # попередня kiosk-сесія впала — спершу повертаємо збережений стан, щоб не «запам'ятати» kiosk-значення як mgOS
    stale && do_leave
    active_pid && { echo "kiosk уже активний (pid $(cat "$ST/active"))"; return 0; }
    echo "$pid" > "$ST/active"

    # 1) профіль живлення до kiosk (сам power-saver тримає kiosk-session через «powerprofilesctl launch»)
    if command -v powerprofilesctl >/dev/null && [ -w "$PPD_DIR" ]; then
        powerprofilesctl get 2>/dev/null > "$PPD_FILE" || rm -f "$PPD_FILE"
    fi
    # 2) gsettings kiosk (зберігаємо поточні; @default — ключ не був змінений користувачем)
    if [ -f "$SESS/gsettings.txt" ]; then
        : > "$ST/gsettings.saved"
        local schema key value cur
        while read -r schema key value; do
            [ -n "$key" ] || continue
            if [ -z "$(dconf read "/${schema//.//}/$key" 2>/dev/null)" ] && command -v dconf >/dev/null; then cur=@default
            else cur=$(gs get "$schema" "$key" | sed 's/^uint64 //'); fi
            [ -n "$cur" ] && printf '%s %s %s\n' "$schema" "$key" "$cur" >> "$ST/gsettings.saved"
            gs set "$schema" "$key" "$value"
        done < "$SESS/gsettings.txt"
    fi
    # 3) GTK-тема Graphite (gtk.css / settings.ini) — оригінали в $ST/gtk
    if [ -d "$SESS/gtk-4.0" ] || [ -d "$SESS/gtk-3.0" ]; then
        rm -rf "$ST/gtk"; mkdir -p "$ST/gtk/gtk-3.0" "$ST/gtk/gtk-4.0"
        local f
        for f in "${GTK_FILES[@]}"; do
            if [ -e "$CFG/$f" ] || [ -L "$CFG/$f" ]; then cp -a "$CFG/$f" "$ST/gtk/$f"; fi
            if [ -e "$SESS/$f" ] || [ -L "$SESS/$f" ]; then
                mkdir -p "$CFG/$(dirname "$f")"; rm -f "$CFG/$f"; cp -a "$SESS/$f" "$CFG/$f"
            fi
        done
    fi
    # 4) localsearch: Nautilus у kiosk не висне 25–30 с на D-Bus (маска зникне сама при перезавантаженні)
    systemctl --user stop "${LOCALSEARCH[@]}" >/dev/null 2>&1
    systemctl --user mask --runtime "${LOCALSEARCH[@]}" >/dev/null 2>&1
    # 5) Google Drive — лише якщо ніхто інший його ще не змонтував
    if [ -f "$CFG/systemd/user/rclone-gdrive.service" ] && command -v rclone >/dev/null \
       && rclone listremotes 2>/dev/null | grep -qx 'drive:' && ! mountpoint -q "$HOME/GoogleDrive"; then
        mkdir -p "$HOME/GoogleDrive"
        systemctl --user start rclone-gdrive.service >/dev/null 2>&1 && touch "$ST/gdrive.started"
    fi
}

case "${1:-}" in
    enter)  do_enter "${2:-}" ;;
    leave)  do_leave ;;
    guard)  stale && { do_leave; echo "kioskOS: попередня kiosk-сесія завершилась аварійно — налаштування повернуто"; } ;;
    status) if active_pid; then echo "kiosk активний (pid $(cat "$ST/active"))"
            elif stale; then echo "kiosk завершився аварійно — потрібен «kioskos-mode guard»"
            else echo "kiosk неактивний"; fi
            [ -f "$PPD_FILE" ] && echo "профіль до kiosk: $(cat "$PPD_FILE")"
            echo "зараз: $(powerprofilesctl get 2>/dev/null)" ;;
    *) echo "використання: kioskos-mode enter|leave|guard|status"; exit 2 ;;
esac
