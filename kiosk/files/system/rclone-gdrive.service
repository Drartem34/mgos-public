[Unit]
Description=Rclone mount for Google Drive (Instant & Memory-Efficient)
AssertPathIsDirectory=/home/doki/GoogleDrive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount drive: /home/doki/GoogleDrive --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 48h --dir-cache-time 1000h --poll-interval 5m --attr-timeout 1000h --drive-list-chunk 1000 --drive-pacer-min-sleep 10ms --drive-pacer-burst 200 --vfs-read-chunk-size 4M --vfs-read-chunk-size-limit 512M --vfs-read-ahead 32M --buffer-size 16M --drive-chunk-size 64M --vfs-fast-fingerprint --no-modtime --umask 022 --log-level NOTICE
ExecStop=/bin/fusermount -u /home/doki/GoogleDrive
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
